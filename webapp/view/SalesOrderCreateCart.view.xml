<sap.ui.core:View
    xmlns="sap.m"
    xmlns:f="sap.ui.layout.form"
    xmlns:sap.ui.layout="sap.ui.layout"
    xmlns:ui="sap.ca.ui"
    xmlns:app="http://schemas.sap.com/sapui5/extension/sap.ui.core.CustomData/1"
    xmlns:sap.ui.core="sap.ui.core" controllerName="cus.sd.zsalesorder.create.view.SalesOrderCreateCart" >

    <Page id="SOC_CREATE_CART_PAGE" title="Sales Order Shopping Cart" class="sapUiFioriObjectPage">
        
        <content>
          <f:SimpleForm id="SO_DeliverySchedulesForm"
                editable="false"
                layout="ResponsiveGridLayout"
                class="deliverySchedulesForm sapUiSmallMarginBottom">
                <f:content>
                    <sap.ui.core:Title id="SO_CartHeader" text="{i18n>DELIVERY_SCHEDULES}" />
                    <HBox alignItems="Center" justifyContent="SpaceBetween" class="deliverySchedulesRow" width="100%">
                        <!-- Customer -->
                        <HBox alignItems="Center">
                            <Label text="{i18n>CUSTOMER}" design="Bold" class="sapUiSmallMarginEnd" width="6.5rem"/>
                            <Text text="{soc_cart>/CustomerName}"/>
                        </HBox>
                    
                        <!-- Requested Delivery Date -->
                        <HBox alignItems="Center">
                            <Label class="soc-table-label-elem-align sapUiSmallMarginEnd" text="{i18n>REQUESTED_DELIVERY}" design="Bold" width="13.5rem"/>
                            <ui:DatePicker id="SOC_CART_SINGLE_RDD"
                                value="{path : 'soc_cart>/formatSingleRdd', type:'sap.ca.ui.model.type.Date', formatOptions: {sytle:'medium'}}"
                                change="setUniformSingleRdd"
                                width="14rem"/>
                        </HBox>
                    </HBox>   
                </f:content>
            </f:SimpleForm>
            <Toolbar >
            <Label text="Status:" class="sapUiSmallMarginBegin sapUiSmallMarginEnd"></Label>
            <Text id="statustxtId" text="{ path:'soc_cart>/oShoppingCartItems/0/ProductID',formatter: '.formatcustomerNumber'}"/>
</Toolbar>
            <MessageStrip text="{ path:'soc_cart>/oShoppingCartItems/0/ProductID',formatter: '.formatoaaMessage'}" 
                          visible="{ path:'soc_cart>/oShoppingCartItems/0/ProductID',formatter: '.visibleMessage'}"
                          type="{ path:'soc_cart>/oShoppingCartItems/0/ProductID',formatter: '.setType'}"
                          showIcon="true" showCloseButton="true" class="sapUiMediumMarginBottom"></MessageStrip>

            
            <!-- Sales Order Table with MultiSelect & Toolbar -->
            <ScrollContainer horizontal="true" vertical="false" width="100%" visible="{=${soc_cart1>/activeTab} === 'sales'}">
                <Table id="SOC_CART_LIST" inset="true" width="1850px"
                    mode="MultiSelect"
                    selectionChange=".onItemSelectionChange"
            		items="{soc_cart>/oShoppingCartItems}">
                    <headerToolbar>
                        <OverflowToolbar>
                            <Title text="{parts:[{path:'i18n>SO_ITM_ORD_ITMS'},{path:'soc_cart>/itemCount'}], formatter:'cus.sd.zsalesorder.create.util.Formatter.getTextPar'}" level="H2" class="sapUiSmallMarginEnd"/>
                            <Button id="btnSalesTab" text="{i18n>SALES}"
                                type="{=${soc_cart1>/activeTab} === 'sales' ? 'Emphasized' : 'Default'}"
                                press=".onPressSalesTab"
                                class="sapUiTinyMarginEnd"/>
                            <Button id="btnConditionsTab" text="{i18n>CONDITIONS}"
                                enabled="{soc_cart1>/isConditionEnabled}"
                                type="{=${soc_cart1>/activeTab} === 'conditions' ? 'Emphasized' : 'Default'}"
                                press=".onPressConditionsTab"/>
                            <ToolbarSpacer/>
                        </OverflowToolbar>
                    </headerToolbar>
                    <columns>
                        <!-- 1. Item -->
                        <Column hAlign="Left" width="4.5rem">
                            <header>
                                <Text text="{i18n>ITEM}" textAlign="Left" width="100%"/>
                            </header>
                        </Column>
                        <!-- 2. Article -->
                        <Column hAlign="Left" width="7rem">
                            <header>
                                <Text text="{i18n>ARTICLE}" textAlign="Left" width="100%"/>
                            </header>
                        </Column>
                        <!-- 3. Target Qty -->
                        <Column hAlign="Left" width="6rem">
                            <header>
                                <Text text="{i18n>TARGET_QTY}" textAlign="Left" width="100%"/>
                            </header>
                        </Column>
                        <!-- 4. UM -->
                        <Column hAlign="Left" width="4.5rem">
                            <header>
                                <Text text="{i18n>UM}" textAlign="Left" width="100%"/>
                            </header>
                        </Column>
                        <!-- 5. Description -->
                        <Column hAlign="Left" width="16rem">
                            <header>
                                <Text text="{i18n>DESCRIPTION}" textAlign="Left" width="100%"/>
                            </header>
                        </Column>
                        <!-- 6. Product No. -->
                        <Column hAlign="Left" width="8rem">
                            <header>
                                <Text text="{i18n>PRODUCT_NO}" textAlign="Left" width="100%"/>
                            </header>
                        </Column>
                        <!-- 7. Value-Adds (Addon) -->
                        <Column hAlign="Center" width="8rem">
                            <header>
                                <Text text="{i18n>VALUE_ADDS}" textAlign="Center" width="100%"/>
                            </header>
                        </Column>
                        <!-- 8. Price/Unit -->
                        <Column hAlign="Left" width="8rem">
                            <header>
                                <Text text="{i18n>PRICE_PER_UNIT}" textAlign="Left" width="100%"/>
                            </header>
                        </Column>
                        <!-- 9. Item Price -->
                        <Column hAlign="Left" width="8rem">
                            <header>
                                <Text text="{i18n>ITEM_PRICE}" textAlign="Left" width="100%"/>
                            </header>
                        </Column>
                        <!-- 10. Sales Person ID -->
                        <Column hAlign="Left" width="8rem">
                            <header>
                                <Text text="{i18n>SALES_PERSON_ID}" textAlign="Left" width="100%"/>
                            </header>
                        </Column>
                        <!-- 11. Site -->
                        <Column hAlign="Left" width="6rem">
                            <header>
                                <Text text="{i18n>SITE}" textAlign="Left" width="100%"/>
                            </header>
                        </Column>
                        <!-- 12. Item Category -->
                        <Column hAlign="Left" width="10rem">
                            <header>
                                <Text text="{i18n>ITEM_CATEGORY}" textAlign="Left" width="100%"/>
                            </header>
                        </Column>
                        <!-- 13. Extended Guarantee Product -->
                        <Column hAlign="Left" width="12rem">
                            <header>
                                <Text text="{i18n>EXT_GUARANTEE_PROD}" textAlign="Left" width="100%"/>
                            </header>
                        </Column>
                        <!-- 14. Rej. Reason -->
                        <Column hAlign="Left" width="9rem">
                            <header>
                                <Text text="{i18n>REJ_REASON}" textAlign="Left" width="100%"/>
                            </header>
                        </Column>
                        <!-- Action (Remove) -->
                        <Column hAlign="Center" width="3.5rem">
                            <header>
                                <Text text=""/>
                            </header>
                        </Column>
                    </columns>
                    <items>
                        <ColumnListItem unread="true" counter="0">
                            <cells>
                                <!-- 1. Item -->
                                <Text id="SOC_ITEM_LINE" text="{soc_cart>itemLine}"/>
                                <!-- 2. Article -->
                                <Text text="{soc_cart>article}"/>
                                <!-- 3. Target Qty -->
                                <Input id="SOC_QTY" liveChange="onNumberEnter" value="{path:'soc_cart>qty', type:'sap.ui.model.type.Integer'}" width="100%"/>
                                <!-- 4. UM -->
                                <Text id="SOC_UOM" text="{soc_cart>UnitofMeasureTxt}"/>
                                <!-- 5. Description -->
                                <ObjectIdentifier id="SOC_DESCRIPTION" title="{soc_cart>ProductDesc}"/>
                                <!-- 6. Product No. -->
                                <Text id="SOC_PRODUCT_NO" text="{soc_cart>ProductID}"/>
                                <!-- 7. Value-Adds (Addon) -->
                                <Button id="btnAddLinkedProd" text="{i18n>VALUE_ADDS}" press="onAddLinkedProd"
                                    visible="{=${soc_cart>addOnFlg} !== 'Y'}" type="Transparent" app:item="{soc_cart>itemLine}"/>
                                <!-- 8. Price/Unit -->
                                <Text text="{path:'soc_cart>pricePerUnit', type:'sap.ui.model.type.Float', formatOptions:{minFractionDigits:2, maxFractionDigits:2}} {soc_cart>currency}"/>
                                <!-- 9. Item Price -->
                                <Text text="{path:'soc_cart>itemPrice', type:'sap.ui.model.type.Float', formatOptions:{minFractionDigits:2, maxFractionDigits:2}} {soc_cart>currency}"/>
                                <!-- 10. Sales Person ID -->
                                <Input value="{soc_cart>salesPersonId}"/>
                                <!-- 11. Site -->
                                <Text text="{soc_cart>site}"/>
                                <!-- 12. Item Category -->
                                <Input value="{soc_cart>itemCategory}" valueHelpRequest=".onItemCategory" showValueHelp="true"/>
                                <!-- 13. Extended Guarantee Product -->
                                <Text text="{soc_cart>extendedGuaranteeProduct}"/>
                                <!-- 14. Rej. Reason -->
                                <Select selectedKey="{soc_cart>rejReason}" width="100%">
                                    <sap.ui.core:Item key="" text="-- None --"/>
                                    <sap.ui.core:Item key="01" text="01 - Cancelled"/>
                                    <sap.ui.core:Item key="02" text="02 - Not Available"/>
                                    <sap.ui.core:Item key="03" text="03 - Replaced"/>
                                </Select>
                                <!-- Action (Remove) -->
                                <Button id="SOC_REMOVE" press="removeItem" tap="removeItem" type="Transparent" icon="sap-icon://sys-cancel" class="sapMLIBSelectD" tooltip="Remove item"/>
                            </cells>
                        </ColumnListItem>
                    </items>
                </Table>
            </ScrollContainer>

            <!-- Conditions Table -->
            <ScrollContainer horizontal="true" vertical="false" width="100%" visible="{=${soc_cart1>/activeTab} === 'conditions'}">
                <Table id="SOC_CONDITIONS_LIST" inset="true" width="100%"
                    items="{soc_cart1>/conditions}">
                    <headerToolbar>
                        <OverflowToolbar>
                            <Title text="{i18n>CONDITIONS}" level="H2" class="sapUiSmallMarginEnd"/>
                            <Button text="{i18n>SALES}"
                                type="{=${soc_cart1>/activeTab} === 'sales' ? 'Emphasized' : 'Default'}"
                                press=".onPressSalesTab"
                                class="sapUiTinyMarginEnd"/>
                            <Button text="{i18n>CONDITIONS}"
                                enabled="{soc_cart1>/isConditionEnabled}"
                                type="{=${soc_cart1>/activeTab} === 'conditions' ? 'Emphasized' : 'Default'}"
                                press=".onPressConditionsTab"/>
                            <ToolbarSpacer/>
                            <Button id="btnAddCondition" text="{i18n>ADD}" icon="sap-icon://add" type="Emphasized" press=".onAddCondition"/>
                        </OverflowToolbar>
                    </headerToolbar>
                    <columns>
                        <!-- 1. Condition Type -->
                        <Column hAlign="Left" width="30%">
                            <header>
                                <Text text="{i18n>CONDITION_TYPE}" textAlign="Left" width="100%"/>
                            </header>
                        </Column>
                        <!-- 2. Amount -->
                        <Column hAlign="Left" width="25%">
                            <header>
                                <Text text="{i18n>AMOUNT}" textAlign="Left" width="100%"/>
                            </header>
                        </Column>
                        <!-- 3. per -->
                        <Column hAlign="Left" width="20%">
                            <header>
                                <Text text="{i18n>PER}" textAlign="Left" width="100%"/>
                            </header>
                        </Column>
                        <!-- 4. Value -->
                        <Column hAlign="Left" width="20%">
                            <header>
                                <Text text="{i18n>VALUE}" textAlign="Left" width="100%"/>
                            </header>
                        </Column>
                        <!-- Action (Delete) -->
                        <Column hAlign="Center" width="5%">
                            <header>
                                <Text text=""/>
                            </header>
                        </Column>
                    </columns>
                    <items>
                        <ColumnListItem>
                            <cells>
                                <!-- 1. Condition Type -->
                                <Input value="{soc_cart1>conditionType}" width="100%"/>
                                <!-- 2. Amount -->
                                <Input value="{soc_cart1>amount}" width="100%"/>
                                <!-- 3. per -->
                                <Input value="{soc_cart1>per}" width="100%"/>
                                <!-- 4. Value -->
                                <Input value="{soc_cart1>value}" width="100%"/>
                                <!-- Action -->
                                <Button icon="sap-icon://delete" type="Transparent" press=".onRemoveCondition" tooltip="Remove condition"/>
                            </cells>
                        </ColumnListItem>
                    </items>
                </Table>
            </ScrollContainer>
            </content>
        
    </Page>
</sap.ui.core:View>
